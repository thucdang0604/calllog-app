<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/floating_bubble_background"
    android:clickable="true"
    android:elevation="8dp"
    android:focusable="true">

    <ImageView
        android:id="@+id/bubble_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_bubble_phone"
        android:contentDescription="Mở công cụ nhanh" />

    <TextView
        android:id="@+id/bubble_badge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bubble_badge_background"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
