<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/barcode_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Center Reticle / Viewfinder Frame -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top translucent mask -->
        <View
            android:id="@+id/mask_top"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_alignParentTop="true"
            android:background="#88000000" />

        <!-- Viewfinder Center Window -->
        <FrameLayout
            android:id="@+id/viewfinder_box"
            android:layout_width="290dp"
            android:layout_height="220dp"
            android:layout_below="@id/mask_top"
            android:layout_centerHorizontal="true"
            android:background="@drawable/viewfinder_border">

            <!-- Laser Scan Line -->
            <View
                android:id="@+id/laser_line"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical"
                android:background="#00E676" />
        </FrameLayout>

        <!-- Left mask -->
        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_below="@id/mask_top"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/viewfinder_box"
            android:background="#88000000" />

        <!-- Right mask -->
        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_below="@id/mask_top"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/viewfinder_box"
            android:background="#88000000" />

        <!-- Bottom mask -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/viewfinder_box"
            android:background="#88000000" />
    </RelativeLayout>

    <!-- Top Bar Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="28dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_barcode_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/camera_control_btn_bg"
            android:contentDescription="Đóng"
            android:padding="10dp"
            android:src="@drawable/ic_camera_close" />

        <TextView
            android:id="@+id/tv_barcode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/camera_control_btn_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🔍 Quét Mã Vạch &amp; QR"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_barcode_flash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/camera_control_btn_bg"
            android:contentDescription="Flash"
            android:padding="10dp"
            android:src="@drawable/ic_camera_flash_off" />
    </RelativeLayout>

    <!-- Bottom Result & Controls Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Last Scanned Code Banner -->
        <TextView
            android:id="@+id/tv_last_scanned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#CC000000"
            android:gravity="center"
            android:padding="10dp"
            android:text="Hướng camera vào mã vạch hoặc mã QR để quét liên tục"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_barcode_counter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/camera_control_btn_bg"
                android:gravity="center"
                android:text="Đã quét: 0 mã"
                android:textColor="#E0FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_barcode_done"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#2E7D32"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="✓ Hoàn tất"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

