<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Top Controls Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/camera_control_btn_bg"
            android:contentDescription="Đóng camera"
            android:padding="10dp"
            android:src="@drawable/ic_camera_close" />

        <TextView
            android:id="@+id/tv_camera_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/camera_control_btn_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="📸 TimeMark Nhanh"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_flash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/camera_control_btn_bg"
                android:contentDescription="Bật tắt đèn Flash"
                android:padding="10dp"
                android:src="@drawable/ic_camera_flash_off" />

            <ImageButton
                android:id="@+id/btn_switch_camera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/camera_control_btn_bg"
                android:contentDescription="Đổi camera trước sau"
                android:padding="10dp"
                android:src="@drawable/ic_camera_switch" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Shutter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="36dp"
        android:paddingTop="20dp">

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#66000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Chụp 1 chạm · Tự động lưu &amp; đóng ngay"
            android:textColor="#E0FFFFFF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_shutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/camera_shutter_button"
            android:contentDescription="Chụp ảnh nhanh" />
    </LinearLayout>

    <!-- Shutter White Flash Animation Overlay -->
    <View
        android:id="@+id/view_flash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF"
        android:visibility="gone" />

</FrameLayout>
